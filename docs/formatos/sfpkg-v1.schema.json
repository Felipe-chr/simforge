{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simforge.dev/schemas/sfpkg-v1.json",
  "title": "SimForge package manifest (.sfpkg) v1",
  "type": "object",
  "required": ["format", "schema", "id", "name", "version", "kind", "publisher", "files"],
  "properties": {
    "format": { "const": "simforge.package" },
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9_-]*){1,}$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "kind": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "device",
          "board",
          "compiler",
          "runtime",
          "solver",
          "exporter",
          "world",
          "theme",
          "bundle"
        ]
      }
    },
    "publisher": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "homepage": { "type": "string", "format": "uri", "maxLength": 512 }
      },
      "additionalProperties": true
    },
    "min_host": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "maxLength": 32
    },
    "license": { "type": "string", "maxLength": 64 },
    "description": { "type": "string", "maxLength": 4000 },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "id", "version"],
        "properties": {
          "path": { "type": "string", "maxLength": 512 },
          "id": { "type": "string", "maxLength": 128 },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
            "maxLength": 64
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "maxLength": 128 },
          "version": { "type": "string", "maxLength": 128 }
        },
        "additionalProperties": true
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
